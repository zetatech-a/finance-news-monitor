# NAVER API HUB (네이버 클라우드 플랫폼)
# 기존 NAVER Developers Center 키(NAVER_CLIENT_ID/SECRET)는 이관 후 무효
# 발급받은 실제 값으로 바꾼 뒤 주석(#)을 해제하세요 — placeholder를 그대로 두면
# 그 문자열로 API를 호출해 원인 파악이 어려운 인증 오류가 난다
#NCP_APIGW_API_KEY_ID=YOUR_APIHUB_CLIENT_ID
#NCP_APIGW_API_KEY=YOUR_APIHUB_CLIENT_SECRET

# Gemini 3줄 요약 (선택) — 미설정이면 기존 추출식 요약을 그대로 사용한다.
# 표시 기사 전체를 요약하는 것이 목표이며, 일반 generateContent 요청 하나에 여러 기사를
# 담는 마이크로배치 방식이다(Google의 비동기 Batch API는 사용하지 않음).
# 실제 키를 이 파일이나 저장소에 커밋하지 말 것 (.env는 .gitignore 대상).
#GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# 기본 모델은 코드에 있음(gemini-3.5-flash-lite). 바꿀 때만 지정한다.
#GEMINI_MODEL=gemini-3.6-flash
# 처리량 제어 (미설정 시 기본값 사용)
#GEMINI_MAX_SUMMARIES=300            # 한 실행에서 요약할 최대 기사 수
#GEMINI_BATCH_MAX_ARTICLES=50        # 요청 1건에 담는 기사 수
#GEMINI_BATCH_HARD_MAX_ARTICLES=100  # 배치 크기 hard cap (초과 설정은 이 값으로 낮춤)
#GEMINI_BATCH_MAX_INPUT_CHARS=150000 # 요청 1건의 입력 문자 예산
#GEMINI_ARTICLE_MAX_CHARS=3000       # 기사 1건의 본문 최대 길이
#GEMINI_MAX_REQUESTS_PER_RUN=12      # 한 실행의 총 generate 요청 상한
#GEMINI_MAX_FETCH_ATTEMPTS=300       # Gemini 전용 본문 크롤링 상한
#GEMINI_REQUEST_TIMEOUT_SECONDS=90
#GEMINI_RETRY_ATTEMPTS=2
#GEMINI_MIN_INTERVAL_SECONDS=2
#GEMINI_CIRCUIT_BREAKER_FAILURES=3
# 무료 티어의 실제 RPM/TPM/RPD는 프로젝트마다 다르므로 AI Studio에서 직접 확인하고
# 위 값(배치 크기·요청 상한·호출 간격)으로 맞춰 조정한다.
# 기능 전체 kill switch (0이면 키가 있어도 호출하지 않음)
#GEMINI_ENABLED=1

# DeepSearch (optional)
DEEPSEARCH_API_KEY=YOUR_DEEPSEARCH_API_KEY

# Email (phase 2)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_id
SMTP_PASS=your_password
MAIL_FROM=report@example.com
MAIL_TO=a@b.com,c@d.com
