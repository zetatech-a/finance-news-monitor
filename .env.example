# NAVER API HUB (네이버 클라우드 플랫폼) — 설정되어 있으면 이 키를 우선 사용
NCP_APIGW_API_KEY_ID=YOUR_APIHUB_CLIENT_ID
NCP_APIGW_API_KEY=YOUR_APIHUB_CLIENT_SECRET

# (레거시 폴백) 기존 NAVER Developers Center — API HUB 키가 없을 때만 사용
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET

# DeepSearch (optional)
DEEPSEARCH_API_KEY=YOUR_DEEPSEARCH_API_KEY

# Email (phase 2)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_id
SMTP_PASS=your_password
MAIL_FROM=report@example.com
MAIL_TO=a@b.com,c@d.com
